# Database (PostgreSQL - Supabase)
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=

# Auth
JWT_SECRET=
JWT_EXPIRATION=1d
# Secreto propio para los tokens de descarga de un solo uso (reportes) — debe
# ser distinto de JWT_SECRET para que nunca sirvan como token de sesión
DOWNLOAD_TOKEN_SECRET=

# Cloudinary (imágenes de productos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Groq (asistente IA)
GROQ_API_KEY=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_USERNAME=NuevaTendenciaBot
TELEGRAM_WEBHOOK_SECRET=

# Resend (emails de recuperación de contraseña)
RESEND_API_KEY=

# App
NODE_ENV=development
PORT=3000
BACKEND_URL=https://tu-app.onrender.com
